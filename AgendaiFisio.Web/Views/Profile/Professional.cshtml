@model ProfessionalProfileViewModel
@{
    ViewData["Title"] = "Perfil profissional";
    var pending = string.IsNullOrWhiteSpace(Model.FullName) || string.IsNullOrWhiteSpace(Model.Street);
    var initials = string.IsNullOrWhiteSpace(Model.FullName) ? "PF" : string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
}
<header class="page-heading"><div><span class="eyebrow">Área profissional</span><h1>@(pending ? "Complete seu perfil" : "Meu perfil profissional")</h1><p>Este é o perfil que os pacientes consultam antes de agendar.</p></div></header>
@if (pending) { <div class="inline-alert inline-alert--warning"><span class="material-symbols-rounded">info</span><span>Complete os dados profissionais, a especialidade e o local de atendimento para aparecer corretamente aos pacientes.</span></div> }

<section class="panel photo-panel">
    <div class="photo-panel__identity">@if (!string.IsNullOrWhiteSpace(Model.PhotoUrl)) { <img class="profile-photo" src="@Model.PhotoUrl" alt="Sua foto de perfil" /> } else { <span class="avatar avatar--xlarge">@initials</span> }<div><h2>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Foto profissional" : Model.FullName)</h2><p>JPEG, PNG ou WebP. Máximo de 5 MB.</p></div></div>
    <div class="photo-panel__actions"><form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" data-photo-form><label class="button button--outline file-button"><span class="material-symbols-rounded">add_a_photo</span> Escolher foto<input type="file" name="photo" accept="image/jpeg,image/png,image/webp" data-photo-input /></label><button type="submit" class="button button--primary" data-photo-submit hidden>Enviar</button></form>@if (!string.IsNullOrWhiteSpace(Model.PhotoUrl)) { <form asp-action="DeletePhoto" method="post" data-confirm="Remover sua foto de perfil?"><button type="submit" class="button button--ghost">Remover</button></form> }</div>
</section>

<form asp-action="UpdateProfessional" method="post" class="profile-form" data-address-form>
    <input asp-for="PhotoUrl" type="hidden" /><input asp-for="Email" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <section class="panel form-panel"><div class="panel__heading"><span class="icon-tile"><span class="material-symbols-rounded">badge</span></span><div><h2>Dados profissionais</h2><p>Identificação e apresentação para os pacientes.</p></div></div>
        <div class="form-grid form-grid--two">
            <div class="form-field form-field--full"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Email"></label><input value="@Model.Email" readonly class="input-readonly" /></div>
            <div class="form-field"><label asp-for="Cpf"></label><input asp-for="Cpf" inputmode="numeric" data-mask="cpf" /><span asp-validation-for="Cpf" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Crefito"></label><input asp-for="Crefito" placeholder="CREFITO-3/100301-F" /><span asp-validation-for="Crefito" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Phone"></label><input asp-for="Phone" inputmode="tel" data-mask="phone" /><span asp-validation-for="Phone" class="field-error"></span></div>
            <div class="form-field"><label asp-for="BirthDate"></label><input asp-for="BirthDate" /><span asp-validation-for="BirthDate" class="field-error"></span></div>
            <div class="form-field form-field--full"><label asp-for="SpecialtyId"></label><select asp-for="SpecialtyId"><option value="">Escolha sua especialidade</option>@foreach (var item in Model.Specialties) { <option value="@item.Id">@item.Nome</option> }</select><span asp-validation-for="SpecialtyId" class="field-error"></span></div>
            <div class="form-field form-field--full"><label asp-for="Bio"></label><textarea asp-for="Bio" rows="5" placeholder="Conte sobre sua experiência e abordagem de atendimento."></textarea><span asp-validation-for="Bio" class="field-error"></span></div>
            <label class="check-field form-field--full"><input asp-for="IsActive" /><span>Perfil ativo e disponível para novos agendamentos</span></label>
        </div>
    </section>
    <section class="panel form-panel"><div class="panel__heading"><span class="icon-tile icon-tile--blue"><span class="material-symbols-rounded">location_on</span></span><div><h2>Local de atendimento</h2><p>Este endereço será exibido aos pacientes.</p></div></div>
        <div class="form-grid form-grid--address">
            <div class="form-field"><label asp-for="ZipCode"></label><div class="input-wrap"><input asp-for="ZipCode" inputmode="numeric" data-cep-input data-mask="cep" /><span class="input-spinner" data-cep-spinner hidden></span></div><span asp-validation-for="ZipCode" class="field-error"></span><small data-cep-feedback></small></div>
            <div class="form-field form-field--street"><label asp-for="Street"></label><input asp-for="Street" data-address-street /><span asp-validation-for="Street" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Number"></label><input asp-for="Number" /><span asp-validation-for="Number" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Complement"></label><input asp-for="Complement" /></div>
            <div class="form-field"><label asp-for="Neighborhood"></label><input asp-for="Neighborhood" data-address-neighborhood /><span asp-validation-for="Neighborhood" class="field-error"></span></div>
            <div class="form-field"><label asp-for="City"></label><input asp-for="City" data-address-city /><span asp-validation-for="City" class="field-error"></span></div>
            <div class="form-field form-field--state"><label asp-for="State"></label><input asp-for="State" maxlength="2" data-address-state /><span asp-validation-for="State" class="field-error"></span></div>
        </div>
    </section>
    <div class="sticky-form-actions"><button type="submit" class="button button--primary button--large"><span class="material-symbols-rounded">check</span> Salvar perfil</button></div>
</form>
