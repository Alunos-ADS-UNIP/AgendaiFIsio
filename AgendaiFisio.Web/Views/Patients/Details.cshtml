@model PatientDetailsViewModel
@{
    ViewData["Title"] = Model.Patient.NomeCompleto;
}
<a asp-action="Index" class="back-link"><span class="material-symbols-rounded">arrow_back</span> Voltar aos pacientes</a>
<header class="page-heading"><div><span class="eyebrow">Paciente</span><h1>@Model.Patient.NomeCompleto</h1><p>Dados cadastrais e histórico disponibilizado para este vínculo profissional.</p></div></header>
<div class="details-grid"><section class="panel"><div class="panel__heading"><span class="avatar">@(string.IsNullOrWhiteSpace(Model.Patient.NomeCompleto) ? "P" : Model.Patient.NomeCompleto[0].ToString().ToUpperInvariant())</span><div><h2>Dados pessoais</h2><p>@Model.Patient.Email</p></div></div><dl class="info-list"><div><dt>CPF</dt><dd>@Model.Patient.Cpf</dd></div><div><dt>Telefone</dt><dd>@Model.Patient.Telefone</dd></div><div><dt>Nascimento</dt><dd>@Model.Patient.DataNascimento.ToString("dd/MM/yyyy")</dd></div><div><dt>Sexo</dt><dd>@Model.Patient.Sexo</dd></div></dl></section><section class="panel"><div class="panel__heading"><span class="icon-tile icon-tile--blue"><span class="material-symbols-rounded">home_pin</span></span><div><h2>Endereço</h2><p>Cadastro informado pelo paciente.</p></div></div><address><strong>@Model.Patient.Endereco.Rua, @Model.Patient.Endereco.Numero</strong><span>@Model.Patient.Endereco.Complemento</span><span>@Model.Patient.Endereco.Bairro</span><span>@Model.Patient.Endereco.Cidade - @Model.Patient.Endereco.Estado</span></address></section></div>
<section class="content-section"><div class="section-heading"><div><h2>Histórico de consultas</h2><p>Atendimentos que seu perfil está autorizado a consultar.</p></div></div>@if (Model.History.Itens.Count == 0) { <div class="empty-card"><span class="material-symbols-rounded">history</span><div><h3>Nenhum atendimento no histórico</h3><p>Não há registros disponíveis para este paciente.</p></div></div> } else { <div class="history-list">@foreach (var item in Model.History.Itens) { var local = BrazilTime.ToLocal(item.DataHora); <a asp-controller="Appointments" asp-action="Details" asp-route-id="@item.AgendamentoId" class="history-item"><span class="icon-tile"><span class="material-symbols-rounded">event_note</span></span><div><h3>@local.ToString("dd/MM/yyyy") às @local.ToString("HH:mm")</h3><p>@item.Status</p></div><span class="material-symbols-rounded">chevron_right</span></a> }</div> }</section>
